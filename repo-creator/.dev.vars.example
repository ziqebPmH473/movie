# ローカル開発（wrangler dev）用のシークレット。
# このファイルを .dev.vars にコピーして値を埋める（.dev.vars は git 管理外）。
# 本番（wrangler deploy 後）は `wrangler secret put 各キー` で登録する。

GITHUB_TOKEN="ghp_xxx"        # repo + workflow スコープの PAT
CF_API_TOKEN="xxx"           # Cloudflare API トークン（Pages 編集権限）
CF_ACCOUNT_ID="xxx"          # Cloudflare アカウントID
ACCESS_PASSCODE="xxx"        # ページにアクセスするための合言葉
